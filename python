package com.example.porterstemmer;
import java.util.Scanner;
public class PorterStemmer {
	static  boolean isVowel(String word,int index) {
		char ch=Character.toLowerCase(word.charAt(index));
		if("aeiou".indexOf(ch)!=-1) {
			return true;
		}
		if(ch=='y') {
			if(index==0) {
				return false;
			}
			return !(isVowel(word,index-1));
		}
		return false;
	}
	static int measure(String stem) {
		int m=0;
		boolean prevVowel=false;
		for(int i=0;i<stem.length();i++) {
			if(isVowel(stem,i)) {
				prevVowel=true;
			}
			else {
				if(prevVowel){
					m++;
				}
				prevVowel=false;
			}
		}
		return m;
	}
	static boolean containsVowel(String word) {
		for(int i=0;i<word.length();i++) {
			if(isVowel(word,i)) {
				return true;
			}
		}
		return false;
	}
	static boolean endswithDoubleConsonant(String word) {
		if(word.length()<2) {
			return false;
		}
		char last=word.charAt(word.length()-1);
		char secondlast=word.charAt(word.length()-2);
		if(last!=secondlast) {
			return false;
		}
		return !isVowel(word,word.length()-1);
	}
	static boolean cvc(String word) {
		if(word.length()<3) {
			return false;
		}
		int len=word.length();
		if(!isVowel(word,len-3)&&isVowel(word,len-2)&&!isVowel(word,len-1)) {
			char last=word.charAt(len-1);
			return last!='w'&&last!='x'&&last!='y';
		}
		return false;
	}
	static String Step1a(String word) {
		if(word.endsWith("sses")) {
			return word.substring(0,word.length()-2);
		}
		if(word.endsWith("ies")) {
			return word.substring(0,word.length()-2);
		}
		if(word.endsWith("ss")) {
			return word;
		}
		if(word.endsWith("s")) {
			return word.substring(0,word.length()-1);
		}
		return word;
	}
	static String Step1b(String word) {
		if(word.endsWith("eed")) {
			String stem=word.substring(0,word.length()-1);
			if(measure(stem)>0) {
				return stem+"ee";
			}
		}
		if(word.endsWith("ed")) {
			String stem=word.substring(0,word.length()-2);
			if(containsVowel(stem)) {
				word=stem;
			}
		}
		else if(word.endsWith("ing")) {
			String stem=word.substring(0,word.length()-3);
			if(containsVowel(stem)) {
				word=stem;
			}
		}
		if(word.endsWith("at")||word.endsWith("bl")||word.endsWith("iz")) {
			word+="e";
		}
		else if(endswithDoubleConsonant(word)&&!"lsz".contains(""+word.charAt(word.length()-1))) {
			word=word.substring(0,word.length()-1);
		}
		else if(measure(word)==1 && cvc(word)) {
			word+="e";
		}
		return word;
	}
	static String step1c(String word) {
		if(word.endsWith("y")) {
			String stem=word.substring(0,word.length()-1);
			if(isVowel(stem,stem.length()-1)) {
				return stem+"i";
			}
		}
		return word;
	}
	static String step2(String word) {
		String[][] rules = {

			    {"ational","ate"},
			    {"tional","tion"},
			    {"enci","ence"},
			    {"anci","ance"},
			    {"izer","ize"},
			    {"abli","able"},
			    {"alli","al"},
			    {"entli","ent"},
			    {"eli","e"},
			    {"ousli","ous"},
			    {"ization","ize"},
			    {"ation","ate"},
			    {"ator","ate"},
			    {"alism","al"},
			    {"iveness","ive"},
			    {"fulness","ful"},
			    {"ousness","ous"},
			    {"aliti","al"},
			    {"iviti","ive"},
			    {"biliti","ble"},
			    {"logi","log"}

			};
		for(String[] rule:rules) {
			if(word.endsWith(rule[0])) {
				String stem=word.substring(0,word.length()-rule[0].length());
				if(measure(stem)>0) {
					return stem=stem+rule[1];
				}
			}
		}
		return word;
	}
	static String step3(String word) {
		String[][] rules = {

			    {"icate","ic"},
			    {"ative",""},
			    {"alize","al"},
			    {"iciti","ic"},
			    {"ical","ic"},
			    {"ful",""},
			    {"ness",""}

			};
		for(String[] rule:rules) {
			if(word.endsWith(rule[0])) {
				String stem=word.substring(0,word.length()-rule[0].length());
				if(measure(word)>0) {
					stem=stem+rule[1];
				}
			}
		}
		return word;
	}
	static String step4(String word) {
		String[] suffixes = {
			    "al",
			    "ance",
			    "ence",
			    "er",
			    "ic",
			    "able",
			    "ible",
			    "ant",
			    "ement",
			    "ment",
			    "ent",
			    "ion",
			    "ou",
			    "ism",
			    "ate",
			    "iti",
			    "ous",
			    "ive",
			    "ize"
			};
		for(String suffix:suffixes) {
			if(word.endsWith(suffix)) {
				String stem=word.substring(0,word.length()-suffix.length());
				if(suffix.equals("ion")) {
					if(measure(stem)>1&&(stem.endsWith("s")||stem.endsWith("t"))) {
						return stem;
					}
				}
				else {
					if(measure(stem)>1) {
						return stem;
					}
				}
			}
		}
		return word;
	}
	static String step5a(String word) {
		if(word.endsWith("e")) {
			String stem=word.substring(0,word.length()-1);
			if(measure(stem)>1) {
				return stem;
			}
			if(measure(stem)==1 && !cvc(stem)) {
				return stem;
			}
		}
		return word;
	}
	static String step5b(String word) {
		if(measure(word)>1 && word.endsWith("ll")) {
			return word.substring(0,word.length()-1);
		}
		return word;
	}
	static String stem(String word) {

	    word = word.toLowerCase();

	    word = Step1a(word);
	    word = Step1b(word);
	    word = step1c(word);
	    word = step2(word);
	    word = step3(word);
	    word = step4(word);
	    word = step5a(word);
	    word = step5b(word);

	    return word;
	}
public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		System.out.println("Enter a Word");
		String word=sc.next();
		System.out.println("Stemmed Word: "+stem(word));
		sc.close();
	}
}
